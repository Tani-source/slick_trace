# SlickTrace backend configuration.
# Copy this file to `.env` and fill in real values. NEVER commit `.env` (see rules.md §1).

# --- Data source credentials (Person A hand-off) ---

# A4 - Copernicus Data Space Ecosystem (the successor to the retired Open Access Hub).
# Register a free "EO Free" account at https://dataspace.copernicus.eu/ (email + password).
# Used by: scripts/download_sentinel1.py
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# A5 - Copernicus Marine Service (CMEMS / Marine Data Store).
# Register at https://data.marine.copernicus.eu, accept the licence for the products
# used (e.g. GLOBAL_ANALYSISFORECAST_PHY_001_024, GLOBAL_MULTIYEAR_PHY_001_030).
# Shared to D for Phase 2 (drift forcing via `copernicus_marine`).
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# A6 - ECMWF ERA5 (Copernicus Climate Data Store / CDS API).
# Profile page: https://cds.climate.copernicus.eu/profile  ->  key is "uid:key".
# Used by D via the `cdsapi` package; must also accept the ERA5 data licence.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=